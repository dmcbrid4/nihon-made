# Leave all values empty for browser storage during local development.
# Cloud mode requires the first four. Production fails closed without cloud setup.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OWNER_EMAIL=

# Optional: comma-separated additional allowed emails, e.g. for family
# members sharing this deployment. Each still needs a real Supabase Auth
# user created for them (Supabase dashboard -> Authentication -> Users ->
# Add user/Invite) -- this app has no self-serve sign-up.
OWNER_EMAILS=
