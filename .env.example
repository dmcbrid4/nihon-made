# Leave all values empty for browser storage during local development.
# Cloud mode requires the first four. Production fails closed without cloud setup.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OWNER_EMAIL=

# Optional: comma-separated additional allowed emails, e.g. for family
# members sharing this deployment, without needing the invite password.
OWNER_EMAILS=

# Optional: a shared password that lets anyone who knows it create their
# own account from the sign-in page's "New here" tab (self-serve, no
# Supabase dashboard step). Leave empty to disable self-serve sign-up
# entirely -- then only OWNER_EMAIL/OWNER_EMAILS can sign in, and those
# still need a Supabase Auth user created for them by hand.
INVITE_PASSWORD=
